[gd_resource type="QuadMesh" format=3]

; Shader 01 (screen-space displacement) requires a card twice as wide as normal - the
; fragment shader slides the albedo UV sideways and the extra width is the room it needs.
[resource]
size = Vector2(2, 1)
center_offset = Vector3(0, 0.5, 0)
subdivide_width = 0
subdivide_depth = 8
