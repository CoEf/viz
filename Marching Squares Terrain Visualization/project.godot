; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Marching Squares Terrain Visualization"
run/main_scene="res://addons/pipeline_viz/runner/walkthrough.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

; 커서가 큰 경우 기본 오프셋 (10, 10) 으로는 툴팁 첫 줄이 커서에 가린다.
mouse_cursor/tooltip_position_offset=Vector2(24, 24)

[gui]

; 기본 0.5초는 코드 단어 위를 훑으며 뜻을 확인하기에 굼뜨다.
timers/tooltip_delay_sec=0.2

[rendering]

rendering_device/driver.windows="d3d12"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

[debug]

; 원본 플러그인 소스를 한 글자도 고치지 않고 그대로 돌리기 위한 완화.
; `var x := ay if ab else min(ay, by)` 처럼 min()이 Variant를 돌려주는 자리가
; 원본에 여러 군데 있는데, 4.7 기본값은 이걸 에러로 올린다.
gdscript/warnings/inference_on_variant=1
